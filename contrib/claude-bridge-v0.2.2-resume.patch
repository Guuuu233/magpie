@@ -412,0 +445,15 @@ function sendPromptToTmux(text: string, id: string): boolean {
+function waitForPendingPrompt(timeoutMs: number): boolean {
+  const deadline = Date.now() + timeoutMs;
+  do {
+    if (paneHasPendingInput(capturePane())) return true;
+    sleepSync(200);
+  } while (Date.now() < deadline);
+  return false;
+}
+
+function paneHasPendingInput(pane: string): boolean {
+  const prompts = pane.split("\n").filter(line => /^\s*(?:❯|>)\s*/.test(line));
+  if (prompts.length === 0) return false;
+  return /^\s*(?:❯|>)\s*\S/.test(prompts[prompts.length - 1]!);
+}
