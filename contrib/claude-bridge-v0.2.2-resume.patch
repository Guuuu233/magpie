diff --git a/src/transcript.ts b/src/transcript.ts
index f1e9480..cc4a298 100644
--- a/src/transcript.ts
+++ b/src/transcript.ts
@@ -89,0 +90,16 @@ export async function listAllTranscriptPaths(root: string = claudeProjectsRoot()
+/**
+ * Locate an existing transcript by Claude session id. Resume mode appends to
+ * the same JSONL file rather than creating a fresh one, so discovery based on
+ * a pre-launch snapshot cannot find it reliably.
+ */
+export async function findTranscriptBySessionId(
+  sessionId: string,
+  root: string = claudeProjectsRoot()
+): Promise<string | null> {
+  const name = `${sessionId}.jsonl`;
+  for (const path of await listAllTranscriptPaths(root)) {
+    if (basename(path) === name) return path;
+  }
+  return null;
+}
+
