@@ -412,0 +431,6 @@ function sendPromptToTmux(text: string, id: string): boolean {
+function paneHasPendingInput(pane: string): boolean {
+  const prompts = pane.split("\n").filter(line => /^\s*(?:❯|>)\s*/.test(line));
+  if (prompts.length === 0) return false;
+  return /^\s*(?:❯|>)\s*\S/.test(prompts[prompts.length - 1]!);
+}
