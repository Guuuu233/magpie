+// Return an explicit Claude session id passed to --resume/-r. A bare resume
+// asks Claude Code to choose a session itself, which is not deterministic
+// enough for the bridge to locate the existing transcript before launch.
+export function claudeResumeSessionId(args: string[]): string | undefined {
+  for (let i = 0; i < args.length; i++) {
+    const arg = args[i]!;
+    if (arg.startsWith("--resume=")) {
+      return arg.slice("--resume=".length) || undefined;
+    }
+    if (arg === "--resume" || arg === "-r") {
+      const next = args[i + 1];
+      return next && !looksLikeOption(next) ? next : undefined;
+    }
+  }
+  return undefined;
+}
