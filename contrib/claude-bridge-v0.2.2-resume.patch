+function transcriptUserText(row: TranscriptRow): string | undefined {
+  if (row.type !== "user") return undefined;
+  const message = (row as { message?: unknown }).message;
+  if (!message || typeof message !== "object") return undefined;
+  const content = (message as { content?: unknown }).content;
+  if (typeof content === "string") return content;
+  if (!Array.isArray(content)) return undefined;
+  const text = content
+    .filter((part): part is Record<string, unknown> => !!part && typeof part === "object")
+    .filter(part => part.type === "text" && typeof part.text === "string")
+    .map(part => part.text as string)
+    .join("");
+  return text || undefined;
+}
+
+/**
+ * Slice a resumed transcript from the row count observed before the new TUI
+ * turn was launched. Unlike prompt-text matching this boundary survives Claude
+ * Code normalizing a large pasted prompt before persisting the user row.
+ */
+export function transcriptRowsAfterBaseline(
+  rows: TranscriptRow[],
+  baselineRows: number
+): TranscriptRow[] | null {
+  if (!Number.isInteger(baselineRows) || baselineRows < 0 || baselineRows > rows.length) {
+    return null;
+  }
+  return rows.slice(baselineRows);
+}
+
+/**
+ * A Claude --resume ... --fork-session transcript contains copied history
+ * before the newly submitted turn. Return only the final occurrence of that
+ * submitted user prompt and the rows after it, so compatibility output never
+ * replays inherited assistant/tool rows. null is fail-closed: without the
+ * submitted prompt there is no safe boundary between inherited and new rows.
+ */
+export function transcriptRowsFromLastUserPrompt(
+  rows: TranscriptRow[],
+  prompt: string
+): TranscriptRow[] | null {
+  let start = -1;
+  for (let i = 0; i < rows.length; i++) {
+    const text = transcriptUserText(rows[i]!);
+    if (text === prompt || text === "Human: " + prompt) start = i;
+  }
+  return start >= 0 ? rows.slice(start) : null;
+}
